<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE" xmlns:simlin="https://simlin.com/XMILE/v1.0">
    <header>
        <name>logistic-growth</name>
        <vendor>Simlin</vendor>
        <product version="0.1.0" lang="en">Simlin</product>
    </header>
    <sim_specs method="euler" time_units="years">
        <start>0</start>
        <stop>100</stop>
        <dt>0.25</dt>
    </sim_specs>
    <model>
        <variables>
            <aux name="carrying_capacity">
                <eqn>12000</eqn>
            </aux>
            <aux name="fractional_growth">
                <eqn>max_growth_rate * (1 - population / carrying_capacity)</eqn>
            </aux>
            <aux name="max_growth_rate">
                <eqn>0.08</eqn>
            </aux>
            <flow name="net_growth">
                <eqn>population * fractional_growth</eqn>
            </flow>
            <stock name="population">
                <eqn>50</eqn>
                <inflow>net_growth</inflow>
            </stock>
        </variables>
        <views>
            <view isee:show_pages="false" page_width="800" page_height="600" type="stock_flow" zoom="100">
                <stock name="population" x="172.5" y="141.9086492765716" label_side="bottom"></stock>
                <flow name="net
growth" x="100" y="141.9086492765716" label_side="bottom">
                    <pts>
                        <pt x="50" y="141.9086492765716"></pt>
                        <pt x="150" y="141.9086492765716"></pt>
                    </pts>
                </flow>
                <aux name="carrying
capacity" x="253.18404128625676" y="50" label_side="bottom"></aux>
                <aux name="fractional
growth" x="213.5906072846467" y="268.22463226233515" label_side="bottom"></aux>
                <aux name="max_growth
rate" x="411.70132624378095" y="224.683477211946" label_side="bottom"></aux>
                <connector angle="259.7164457893804">
                    <from>carrying
capacity</from>
                    <to>fractional
growth</to>
                </connector>
                <connector angle="192.39549999910227">
                    <from>max_growth
rate</from>
                    <to>fractional
growth</to>
                </connector>
                <connector angle="295.93228060646857">
                    <from>population</from>
                    <to>fractional
growth</to>
                </connector>
                <connector angle="151.9637029479843">
                    <from>fractional
growth</from>
                    <to>net
growth</to>
                </connector>
                <connector angle="135">
                    <from>population</from>
                    <to>net
growth</to>
                </connector>
            </view>
        </views>
    </model>
</xmile>