{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib",
    "module": "commonjs",
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ],
    // Since TS6 "types" defaults to []. ts-jest type-checks tests/ against this
    // config, so Jest's globals must stay reachable. Note ResizeObserver comes
    // from lib.dom now, so @types/resize-observer-browser is not listed.
    "types": ["jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "lib",
    "lib.browser",
    "tests"
  ],
  "references": [
    { "path": "../core/tsconfig.json" },
    { "path": "../engine/tsconfig.json" }
  ]
}
