{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib",
    "module": "commonjs",
    // No "types" entry: since TS6 it defaults to [] rather than every installed
    // @types package, and nothing here needs ambient globals -- test helpers are
    // imported from @rstest/core, and ResizeObserver now comes from lib.dom
    // (so @types/resize-observer-browser is gone).
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "lib",
    "lib.browser",
    "tests"
  ],
  "references": [
    { "path": "../core/tsconfig.json" },
    { "path": "../engine/tsconfig.json" }
  ]
}
