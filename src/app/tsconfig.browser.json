{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "lib.browser",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "noEmit": true,
    // Since TS6 "types" defaults to []. App.tsx reads process.env at build time.
    // No "jest" entry: ts-jest runs this package transpile-only (isolatedModules),
    // so it never type-checks the tests and @types/jest is not a dependency.
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../**/*.ts",
    "../**/*.tsx"
  ],
  "exclude": [
    "lib",
    "lib.browser",
    "../**/tests/**",
    "../**/test/**",
    "../**/*.test.ts",
    "../**/*.spec.ts",
    "../server/**",
    "../simlin-serve/**",
    "../**/node_modules/**",
    "../engine/src/internal/wasm.node.ts"
  ],
  "references": [
    { "path": "../core/tsconfig.browser.json" },
    { "path": "../diagram/tsconfig.browser.json" },
    { "path": "../engine/tsconfig.browser.json" }
  ]
}
