{
  "name": "@simlin/core",
  "version": "1.3.5",
  "description": "System dynamics data model and utilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/bpowers/simlin.git",
    "directory": "src/core"
  },
  "author": {
    "name": "Bobby Powers",
    "email": "bobbypowers@gmail.com"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "module": "lib.module",
  "main": "lib",
  "types": "lib/index.d.ts",
  "exports": {
    "./*": {
      "types": "./lib/*.d.ts",
      "module": "./lib.module/*.js",
      "node": "./lib/*.js"
    },
    "./common": {
      "types": "./lib/common.d.ts",
      "module": "./lib.module/common.js",
      "node": "./lib/common.js"
    },
    "./canonicalize": {
      "types": "./lib/canonicalize.d.ts",
      "module": "./lib.module/canonicalize.js",
      "node": "./lib/canonicalize.js"
    },
    "./datamodel": {
      "types": "./lib/datamodel.d.ts",
      "module": "./lib.module/datamodel.js",
      "node": "./lib/datamodel.js"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "module": "./lib.module/index.js",
      "node": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib",
    "lib.module"
  ],
  "dependencies": {
    "@simlin/engine": "workspace:^"
  },
  "devDependencies": {
    "@rstest/core": "^0.11.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "needs-format": "prettier -l '*.ts'",
    "format": "prettier --write '*.ts'",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf ./lib ./lib.module",
    "build": "tsc && tsc -p tsconfig.browser.json",
    "test": "rstest run",
    "test:watch": "rstest watch"
  }
}
