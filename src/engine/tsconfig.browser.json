{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "lib.browser",
    "tsBuildInfoFile": "./tsconfig.browser.tsbuildinfo",
    "module": "esnext",
    // Nothing in the browser program touches Node globals (wasm.node.ts is
    // excluded below), and tests are excluded, so no ambient type packages.
    // backend-factory.direct.ts and internal/wasm.supplied.ts are platform-neutral
    // and deliberately compile into lib.browser too: single-file browser bundles
    // (src/notebook-widget) alias the two platform specifiers to them.
    "types": [],
    "paths": {
      "@simlin/engine/internal/wasm": ["./src/internal/wasm.browser.ts"],
      "@simlin/engine/internal/backend-factory": ["./src/backend-factory.browser.ts"],
      "@simlin/engine/*": ["./src/*"]
    }
  },
  "exclude": ["lib", "lib.browser", "src/internal/wasm.node.ts", "tests", "eslint.config.js"]
}
