{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib",
    "module": "commonjs",
    // Since TS6 "types" defaults to [] rather than every installed @types package.
    // Test globals are imported explicitly from @rstest/core, so no test-runner
    // entry is needed here even though the vendored seshcookie tests sit beside
    // their source and are part of this program.
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "schemas/**/*.js"
  ],
  "exclude": [
    "lib",
    "lib.browser"
  ],
  "references": [
    { "path": "../core/tsconfig.json" }
  ]
}
