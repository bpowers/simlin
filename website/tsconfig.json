{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    // "node"/"node10" was removed in TypeScript 7; rspress bundles this code.
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    // "baseUrl" was removed in TypeScript 7. Without it these targets resolve
    // relative to this file, so they must be written relative (TS5090).
    "paths": {
      "@/*": ["./src/*"],
      "@simlin/core": ["../src/core"],
      "@simlin/diagram": ["../src/diagram"],
      "@simlin/engine": ["../src/engine"]
    }
  },
  "include": ["src/", "docs/", "rspress.config.ts"],
  "exclude": ["node_modules", "build"]
}